# Redirect all traffic to Node.js application
# This file should be placed in your public_html or application root directory

RewriteEngine On

# Don't rewrite files or directories that exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Proxy all requests to the Node.js app
# Replace PORT_NUMBER with your actual Node.js app port (usually shown in cPanel)
RewriteRule ^(.*)$ http://127.0.0.1:PORT_NUMBER/$1 [P,L]

# Enable CORS if needed
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
